# Canvas LMS app environment
# Copy to app.env and fill in your values

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=canvas-lms.example.com
BASE_DOMAIN_NAME=example.com

# Application secret
APP_SECRET_KEY=replace-with-a-random-password

# Admin credentials
APP_ADMIN_USER=admin
APP_ADMIN_PASS=replace-with-a-random-password

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=canvas
DB_USER_NAME=canvas
DB_USER_PASS=replace-with-a-random-password

# Email / SMTP
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_LOGIN_NAME=
EMAIL_SERVER_LOGIN_PASS=
