# Canvas LMS environment configuration

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=$HOSTNAME
BASE_DOMAIN_NAME=example.com

# Application secret
APP_SECRET_KEY=changeme_secret_key_min_32_chars

# Admin credentials
APP_ADMIN_USER=admin
APP_ADMIN_PASS=changeme_admin_password

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=canvas
DB_USER_NAME=canvas
DB_USER_PASS=changeme_db_password

# Email / SMTP
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
